{
  "manifest_version": 3,
  "name": "OpenClaw Game Mode",
  "version": "1.0",
  "description": "Pause/resume work for gaming via Command Center dashboard",
  "permissions": [
    "scripting",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3001/*",
        "http://127.0.0.1:3001/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
