  "preflight_rules": {
    "command-center": {
      "safe_edits": [
        "src/",
        "package.json",
        "tsconfig.json",
        "README.md",
        ".env.local"
      ],
      "dangerous_edits": [
        "LaunchAgent plist",
        "gateway config",
        "workspace config"
      ],
      "restart_command": "launchctl restart com.alfred.dashboard-nextjs",
      "restart_required_for": [
        "Environment variable changes",
        "Port configuration",
        "LaunchAgent config"
      ],
      "rollback_command": "git checkout HEAD -- src/ package.json && npm install && npm run build"
    },
    "gateway": {
      "safe_edits": [],
      "dangerous_edits": [
        "All changes to gateway code or config"
      ],
      "approval_required": true,
      "approval_contact": "Joe",
      "restart_command": "launchctl restart com.alfred.gateway-core",
      "restart_required_for": [
        "Any code or configuration change"
      ],
      "rollback_command": "git checkout HEAD -- . && docker build -t openclaw-gateway ."
    },
    "workspace": {
      "safe_edits": [
        "memory/",
        "scripts/",
        "SOUL.md",
        "AGENTS.md",
        "IDENTITY.md",
        "config/",
        "plans/",
        "reports/"
      ],
      "dangerous_edits": [
        "PROTECTED files: AGENTS.md security rules, protected config references"
      ],
      "restart_command": null,
      "restart_required_for": []
    },
    "cron-scheduler": {
      "safe_edits": [
        "Job payload additions",
        "New job definitions"
      ],
      "dangerous_edits": [
        "Deleting existing jobs",
        "Changing job schedule without testing",
        "Modifying job delivery channels"
      ],
      "approval_required_for": [
        "Deleting active jobs",
        "Changing production job schedules"
      ],
      "restart_command": "launchctl restart com.alfred.gateway-core",
      "restart_required_for": [
        "Any changes to jobs.json"
      ]
    },
    "sentinel": {
      "safe_edits": [
        "sentinel-playbook.json",
        "sentinel.sh"
      ],
      "dangerous_edits": [
        "Removing monitoring components",
        "Disabling auto-healing"
      ],
      "restart_command": "launchctl restart com.alfred.sentinel",
      "restart_required_for": [
        "Changes to monitoring logic"
      ]
    }
  },
  "validation_notes": {
    "required_fields": [
      "name",
      "aliases",
      "repo_path",
      "owner"
    ],
    "optional_fields": [
      "source_repo",
      "public_url",
      "docker",
      "restart_requires_approval",
      "notes"
    ]
  }
