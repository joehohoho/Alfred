{
  "name": "signal-app-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Stock/Crypto buy-sell signal app MVP with SMA+RSI strategy",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "psql $DATABASE_URL -f db/migrations/001_init.sql",
    "signals:run": "tsx src/services/pipeline/runPipeline.ts",
    "scheduler:start": "tsx src/services/scheduler/index.ts",
    "backtest": "tsx src/cli/backtest.ts",
    "backtest:sma": "tsx src/cli/backtest.ts --symbol BTC --strategy SMA_RSI_IMPROVED --days 90",
    "backtest:macd": "tsx src/cli/backtest.ts --symbol BTC --strategy MACD --days 90",
    "backtest:bollinger": "tsx src/cli/backtest.ts --symbol BTC --strategy BOLLINGER --days 90",
    "backtest:compare": "tsx src/cli/backtest.ts --symbol BTC --compare-all --days 90",
    "backtest:optimize": "tsx src/cli/backtest.ts --symbol BTC --strategy SMA_RSI_IMPROVED --optimize"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "^14.2.35",
    "node-cron": "3.0.3",
    "pg": "8.13.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.12.7",
    "tailwind-merge": "2.5.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.7.4",
    "@types/node-cron": "3.0.11",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.9",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "^16.2.1",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "tsx": "^4.21.0",
    "typescript": "5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
